{
  "name": "react-example",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:vercel": "vercel dev --listen 4000",
    "dev:all": "echo 'Run these in separate terminals: npm run dev (frontend) + npm run dev:vercel (API)'",
    "deploy:env": "node scripts/sync-all-server-env.mjs",
    "deploy:env:preview": "node scripts/sync-preview-env.mjs",
    "deploy:prod": "vercel deploy --prod --yes",
    "deploy:rules": "firebase deploy --only firestore:rules --project cognapse-93cdf",
    "build": "vite build",
    "preview": "vite preview",
    "vault": "tsx server/index.ts",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit && eslint src/",
    "lint:tsc": "tsc --noEmit",
    "lint:eslint": "eslint src/"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@types/cors": "^2.8.19",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^12.9.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "compromise": "^14.15.0",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.12.1",
    "firebase-admin": "^13.10.0",
    "framer-motion": "^12.38.0",
    "groq-sdk": "^1.1.2",
    "html2canvas": "^1.4.1",
    "idb-keyval": "^6.2.4",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.12.0",
    "motion": "^12.23.24",
    "razorpay": "^2.9.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-force-graph-2d": "^1.29.1",
    "tailwind-merge": "^3.5.0",
    "uuid": "^14.0.0",
