rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(ownerId) {
      return signedIn() && request.auth.uid == ownerId;
    }

    match /shared_research/{shareId} {
      allow read: if resource.data.active != false
        && (
          resource.data.visibility in ['unlisted', 'public']
          || isOwner(resource.data.ownerId)
        );
      allow create: if isOwner(request.resource.data.ownerId);
      allow update, delete: if isOwner(resource.data.ownerId);
    }

    match /intelligence_reports/{reportId} {
      allow read: if signedIn() && resource.data.user_id == request.auth.uid;
      allow create: if signedIn() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.user_id == request.auth.uid;
    }

    match /user_stats/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /user_settings/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /notebook/{noteId} {
      allow read: if signedIn() && resource.data.user_id == request.auth.uid;
      allow create: if signedIn() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.user_id == request.auth.uid;
    }

    // Premium is written only by trusted server; users may delete on account purge.
    match /user_premium/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if false;
      allow delete: if isOwner(userId);
    }

    // Premium Document Intelligence — server-side writes only (via Firebase Admin SDK)
    match /user_documents/{documentId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if false; // Server-side only via Admin SDK
      allow update: if false; // Server-side only
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // Document Intelligence — RAG chunk storage, server-side writes only
    match /document_chunks/{chunkId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if false; // Server-side only via Admin SDK
      allow update: if false; // Server-side only
      allow delete: if false; // Server-side only
    }

    // Ops Telemetry — writes restricted to server-side API only; no direct client access
    match /ops_telemetry/{eventId} {
      allow create: if false;
      allow read, update, delete: if false;
    }

    // Active Sessions — single-instance enforcement (last writer wins)
    match /activeSessions/{userId} {
      allow read, write: if isOwner(userId);
    }
  }
}
