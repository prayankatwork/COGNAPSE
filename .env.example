# --- Client (Vite) — safe to expose in the browser bundle ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# Must match RAZORPAY_KEY_ID (same test vs live). Checkout uses the server key when available.
VITE_RAZORPAY_KEY_ID=

# Firebase Admin (server only) — required for /api/create-order auth and premium activation
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_WEB_API_KEY=

# Local-only fallbacks (never enable in production deployments)
# VITE_ALLOW_LOCAL_VAULT=true

# --- Server (Vercel) — NEVER prefix with VITE_ ---
GEMINI_API_KEY=
GROQ_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Shared secret for Ops Command Centre telemetry API access
OPS_TELEMETRY_API_KEY=

# Optional
# ALLOWED_ORIGINS=https://cognapse.vercel.app,http://localhost:3000,http://localhost:4000
# COGNAPSE_REQUIRE_AUTH=true
# ALLOW_DEV_BYPASS=true
