{
  "$schema": "./tokens.schema.json",
  "meta": {
    "name": "COGNAPSE",
    "tagline": "Strategic Intelligence Analyst OS",
    "version": "1.0.0"
  },
  "color": {
    "light": {
      "bg": "#FDFCFB",
      "sidebar": "#F8F9FA",
      "ink": "#1A1A1A",
      "accent": "#2A4365",
      "accentRgb": "42, 67, 101",
      "signal": "#F27D26",
      "signalRgb": "242, 125, 38",
      "border": "#E2E8F0",
      "muted": "#718096",
      "callout": "#F1F5F9",
      "syn": "#334155",
      "score": "#EBF8FF",
      "success": "#10B981",
      "conflictBg": "#FFF5F5",
      "conflictBorder": "#FEB2B2",
      "conflictText": "#C53030"
    },
    "dark": {
      "bg": "#000000",
      "sidebar": "#0A0A0A",
      "ink": "#FFFFFF",
      "accent": "#FACC15",
      "accentRgb": "250, 204, 21",
      "signal": "#F27D26",
      "signalRgb": "242, 125, 38",
      "border": "#222222",
      "muted": "#888888",
      "callout": "#111111",
      "syn": "#CCCCCC",
      "score": "#332B00",
      "success": "#10B981",
      "conflictBg": "#1A0505",
      "conflictBorder": "#4A1212",
      "conflictText": "#FC8181"
    }
  },
  "typography": {
    "serif": "Lora, Georgia, serif",
    "sans": "Inter, system-ui, sans-serif",
    "mono": "JetBrains Mono, monospace",
    "roles": {
      "display": { "family": "serif", "weight": 700, "style": "italic", "tracking": "tight" },
      "title": { "family": "serif", "size": "32px", "lineHeight": 1.1 },
      "sectionLabel": { "family": "sans", "size": "10px", "weight": 900, "transform": "uppercase", "tracking": "0.3em" },
      "controlLabel": { "family": "sans", "size": "9px", "weight": 900, "transform": "uppercase", "tracking": "0.2em" },
      "body": { "family": "sans", "size": "14px", "lineHeight": 1.6 },
      "synthesis": { "family": "sans", "size": "13px", "lineHeight": 1.6, "colorToken": "syn" },
      "meta": { "family": "sans", "size": "9px", "weight": 700, "transform": "uppercase", "tracking": "0.15em", "colorToken": "muted" }
    }
  },
  "radius": {
    "none": "0",
    "sm": "2px",
    "md": "4px",
    "lg": "8px",
    "full": "9999px"
  },
  "spacing": {
    "panelPadding": "1rem",
    "sectionGap": "1.5rem",
    "navHeight": "56px"
  },
  "motion": {
    "fast": "150ms",
    "normal": "300ms",
    "slow": "800ms",
    "allowed": ["pulse", "spin-slow", "fade-in", "slide-in"],
    "forbidden": ["bounce-decorative", "layout-shift-loops"]
  }
}
